%cd /content

save_path = '/content/drive/MyDrive/RVC_Backup/' #@param {type:"string"}
model = 'kaavoos' #@param {type:"string"}

# !mkdir meme
os.makedirs("meme", exist_ok=True)
!sleep 3

!cp "{save_path}{model}/{model}.index" "meme/added_{model}_v2.index"
!cp $(find '{save_path}{model}/' -name '{model}_*e_*s.pth') meme/

%cd meme/
!sleep 5
!zip -0 -r "{model}.zip" *
!sleep 5
!mv "{model}.zip" "{save_path}{model}/{model}.zip"

