#@title Goo

%cd /content
!wget -q "https://go.dev/dl/go1.27.1.linux-amd64.tar.gz"
!tar -xf "go1.27.1.linux-amd64.tar.gz"
!rm -rf go1*
import os
os.environ["PATH"] += os.pathsep + "/content/go/bin"
!git clone --depth 1 https://github.com/jarondusty/credleg
%cd /content/credleg/goo
!go mod download
!GOAMD64=v3 CGO_ENABLED=0 go build --ldflags="-s -w" -o doit
!chmod +x doit
!./doit
